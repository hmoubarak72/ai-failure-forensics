# Leave OPENAI_API_KEY empty to run fully offline with the deterministic mock LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# auto | openai | mock
LLM_PROVIDER=auto
# auto | llm | heuristic   (auto = LLM-as-judge when OpenAI is configured)
JUDGE_PROVIDER=auto
# Prompt version served by default: v1 | v2 | v3
PIPELINE_VERSION=v1
# Generate the demo scenario on first start (1/0)
FORENSICS_SEED_DEMO=1
# Optional: export OpenTelemetry spans to Jaeger/Tempo/Honeycomb
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
